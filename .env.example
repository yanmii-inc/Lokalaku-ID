# Environment Configuration for Lokalaku Local Development

# API Configuration
PORT=8080
ENV=development
SHUTDOWN_TIMEOUT_SECONDS=10
JWT_SECRET=lokalaku_dev_jwt_secret_32bytes_long_key!!

# PostgreSQL Configuration
POSTGRES_USER=lokalaku
POSTGRES_PASSWORD=lokalaku_dev_pass
POSTGRES_DB=lokalaku
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=lokalaku_dev_redis
REDIS_PORT=6379

# Mailpit Configuration (Dev Email/OTP capture)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
